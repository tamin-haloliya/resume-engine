{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/resume-engine/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/resume-engine/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/resume-engine",
  "projects": {
    "resume-engine": {
      "type": "application",
      "root": "apps/resume-engine",
      "entryFile": "main",
      "sourceRoot": "apps/resume-engine/src",
      "compilerOptions": {
        "tsConfigPath": "apps/resume-engine/tsconfig.app.json"
      }
    },
    "env-validation": {
      "type": "library",
      "root": "libs/env-validation",
      "entryFile": "index",
      "sourceRoot": "libs/env-validation/src",
      "compilerOptions": {
        "tsConfigPath": "libs/env-validation/tsconfig.lib.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    }
  }
}
